<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PalestraLog.ViewModels"
             x:Class="PalestraLog.Views.StoricoPage"
             x:Name="PageRoot"
             x:DataType="vm:StoricoViewModel"
             Title="Storico">

    <Grid Padding="16">
        <CollectionView ItemsSource="{Binding Sessioni}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Nessuna sessione completata"
                       FontSize="16" HorizontalTextAlignment="Center"
                       VerticalOptions="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SessioneRiepilogo">
                    <SwipeView Margin="0,4">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Elimina"
                                           BackgroundColor="OrangeRed"
                                           Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EliminaSessioneCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border StrokeShape="RoundRectangle 10"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ApriDettaglioCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding GiornoNome}"
                                           FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding DataFormattata}"
                                           FontSize="13" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding DurataFormattata}"
                                       FontSize="18" FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Primary}" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
