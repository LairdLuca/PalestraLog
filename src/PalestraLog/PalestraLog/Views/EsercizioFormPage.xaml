<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PalestraLog.ViewModels"
             x:Class="PalestraLog.Views.EsercizioFormPage"
             x:DataType="vm:EsercizioFormViewModel"
             Title="{Binding TitlePagina}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="14">

            <Label Text="{Binding Errore}"
                   TextColor="Red"
                   FontSize="14"
                   IsVisible="{Binding Errore, Converter={StaticResource IsNotNullConverter}}" />

            <Label Text="Nome Esercizio" FontSize="14" TextColor="Gray" />
            <Entry Text="{Binding Nome}"
                   Placeholder="es. Panca Piana"
                   FontSize="18"
                   HeightRequest="50" />

            <Label Text="Tipo" FontSize="14" TextColor="Gray" />
            <Picker ItemsSource="{Binding TipiEsercizio}"
                    SelectedIndex="{Binding TipoSelezionato}"
                    IsEnabled="{Binding IsEdit, Converter={StaticResource InvertedBoolConverter}}"
                    FontSize="18"
                    HeightRequest="50" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding IsTemporaneo}" />
                <Label Text="Solo per questa sessione"
                       VerticalOptions="Center" FontSize="14" />
            </HorizontalStackLayout>

            <!-- Target Pesi / Corpo Libero -->
            <VerticalStackLayout Spacing="10"
                                 IsVisible="{Binding IsCardio, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Target" FontSize="16" FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="Serie" FontSize="13" TextColor="Gray" />
                        <Entry Text="{Binding SerieTarget}" Keyboard="Numeric"
                               FontSize="18" HeightRequest="45" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Ripetizioni" FontSize="13" TextColor="Gray" />
                        <Entry Text="{Binding RipetizioniTarget}" Keyboard="Numeric"
                               FontSize="18" HeightRequest="45" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout>
                    <Label Text="Peso (kg)" FontSize="13" TextColor="Gray" />
                    <Entry Text="{Binding PesoTarget}" Keyboard="Numeric"
                           FontSize="18" HeightRequest="45" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsCorpoLibero}">
                    <Label Text="Durata hold (secondi)" FontSize="13" TextColor="Gray" />
                    <Entry Text="{Binding DurataTargetSecondi}" Keyboard="Numeric"
                           FontSize="18" HeightRequest="45" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Target Cardio -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsCardio}">
                <Label Text="Target Cardio" FontSize="16" FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <VerticalStackLayout>
                        <Label Text="Velocità (km/h)" FontSize="13" TextColor="Gray" />
                        <Entry Text="{Binding VelocitaTarget}" Keyboard="Numeric"
                               FontSize="18" HeightRequest="45" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Inclinazione (%)" FontSize="13" TextColor="Gray" />
                        <Entry Text="{Binding InclinazioneTarget}" Keyboard="Numeric"
                               FontSize="18" HeightRequest="45" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1">
                        <Label Text="Durata (secondi)" FontSize="13" TextColor="Gray" />
                        <Entry Text="{Binding DurataTargetSecondi}" Keyboard="Numeric"
                               FontSize="18" HeightRequest="45" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label Text="Distanza (km)" FontSize="13" TextColor="Gray" />
                        <Entry Text="{Binding DistanzaTarget}" Keyboard="Numeric"
                               FontSize="18" HeightRequest="45" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <Label Text="Note" FontSize="14" TextColor="Gray" />
            <Editor Text="{Binding Note}"
                    Placeholder="es. +2.5kg ogni settimana, EMOM 10min..."
                    FontSize="14"
                    HeightRequest="70" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                <Button Text="ANNULLA"
                        FontSize="16" HeightRequest="56" CornerRadius="12"
                        BackgroundColor="Gray" TextColor="White"
                        Command="{Binding AnnullaCommand}" />
                <Button Grid.Column="1"
                        Text="SALVA"
                        FontSize="16" FontAttributes="Bold"
                        HeightRequest="56" CornerRadius="12"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        Command="{Binding SalvaCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
