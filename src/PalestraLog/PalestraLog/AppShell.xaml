<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PalestraLog.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PalestraLog.Views"
    Title="PalestraLog">

    <TabBar>
        <ShellContent Title="Home"
                      Icon="icon_home"
                      ContentTemplate="{DataTemplate views:HomePage}"
                      Route="home" />
        <ShellContent Title="Storico"
                      Icon="icon_history"
                      ContentTemplate="{DataTemplate views:StoricoPage}"
                      Route="storico" />
    </TabBar>

</Shell>
